# 聚水潭新版开放平台应用凭证。复制为 .env 后填写真实值。
JST_APP_KEY=
JST_APP_SECRET=

# 正式环境。测试环境请按聚水潭控制台给出的地址修改。
JST_ENDPOINT=https://openapi.jushuitan.com

# 单次 HTTP 请求超时（秒）。
JST_TIMEOUT_SECONDS=30

# 可选：Token 缓存文件。留空时使用当前 Windows 用户的 LocalAppData。
# JST_TOKEN_CACHE_PATH=D:\path\to\jst-token.json

# 远程 MCP HTTP 服务。Docker 内部固定监听 0.0.0.0:8000；以下值用于本机或服务器端口映射。
JST_MCP_PATH=/mcp
JST_MCP_BIND_ADDRESS=127.0.0.1
JST_MCP_PUBLIC_PORT=18090

# Remote MCP OAuth. Keep the Feishu secret only in the server-side .env file.
JST_MCP_PUBLIC_URL=https://jushuitan-mcp.kktree.cn
# JST_MCP_OAUTH_DB_PATH=.runtime/oauth.db
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_TENANT_KEY=
FEISHU_REDIRECT_URI=https://jushuitan-mcp.kktree.cn/oauth/feishu/callback
